POSTGRES_USER=netflix
POSTGRES_PASSWORD=netflix
POSTGRES_DB=netflix_catalog

# Docker Compose: hostname is the db service.
DATABASE_URL=postgresql+psycopg2://netflix:netflix@netflix_db:5432/netflix_catalog
# Local CLI from the host (Postgres published on localhost:5432):
# DATABASE_URL=postgresql+psycopg2://netflix:netflix@localhost:5432/netflix_catalog

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
